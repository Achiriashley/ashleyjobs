# Copy this file to .env.local and fill in real values.
# .env.local is already gitignored — never commit real secrets.

# --- Clerk (authentication) ---
# https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# These four are just route paths in this app, not values from the Clerk
# dashboard — leave them as-is unless you rename the sign-in/sign-up pages.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- MongoDB (via mongoose) ---
# Full connection string, e.g. mongodb+srv://user:pass@cluster.mongodb.net/dbname
MONGODB=

# --- Stripe (membership payments) ---
# https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=
# Base URL used to build Stripe checkout success/cancel redirect links,
# e.g. http://localhost:3000 in development.
URL=

# --- Supabase (candidate list / feed / onboarding uploads) ---
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- EmailJS (transactional email) ---
# https://dashboard.emailjs.com/admin
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
